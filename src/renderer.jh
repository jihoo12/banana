import api
import std.ffi
import std.fs
import terminal

const ATLAS: i32 = 2048

struct Vertex { x: f32, y: f32, u: f32, v: f32, r: f32, g: f32, b: f32, a: f32 }
struct Glyph { x: i32, y: i32, w: i32, h: i32, left: i32, top: i32 }

pub struct Renderer {
    pub cell_width: i64
    pub cell_height: i64
    pub padding: i64
    font: *u8
    ascent: i64
    shader: u32
    vao: u32
    vbo: u32
    texture: u32
    screen: i32
    glyphs: Map(u32, Glyph)
    atlas_x: i32
    atlas_y: i32
    atlas_row: i32
    backgrounds: Vec(Vertex)
    text: Vec(Vertex)
}

unsafe fn shader(kind: u32, source: *u8) -> u32 {
    let id = api.glCreateShader(kind)
    var p = source
    api.glShaderSource(id, 1, &p, null)
    api.glCompileShader(id)
    var okay: i32 = 0
    api.glGetShaderiv(id, 0x8b81, &okay)
    if okay == 0 {
        var log = [0 as u8; 2048]
        api.glGetShaderInfoLog(id, 2048, null, &log[0])
        println(ffi.copy_c_string(&log[0]))
        panic("OpenGL shader compilation failed")
    }
    id
}

fn quad(inout vertices: Vec(Vertex), x: f32, y: f32, w: f32, h: f32,
    u: f32, v: f32, uw: f32, vh: f32, rgb: u32, alpha: f32) {
    let r = ((rgb >> 16) & 255) as f32 / 255.0
    let g = ((rgb >> 8) & 255) as f32 / 255.0
    let b = (rgb & 255) as f32 / 255.0
    let a = Vertex { x, y, u, v, r, g, b, a: alpha }
    let c = Vertex { x: x + w, y: y + h, u: u + uw, v: v + vh, r, g, b, a: alpha }
    let b1 = Vertex { x: x + w, y, u: u + uw, v, r, g, b, a: alpha }
    let d = Vertex { x, y: y + h, u, v: v + vh, r, g, b, a: alpha }
    vertices.push(a); vertices.push(b1); vertices.push(c)
    vertices.push(a); vertices.push(c); vertices.push(d)
}

impl Renderer {
    pub fn new(family: str, size: i64, scale: f32) -> Renderer {
        let name = ffi.c_string(family).unwrap()
        let pixels = terminal.clamp((size as f32 * scale) as i64, 8, 96)
        unsafe {
            let font = api.banana_font_open(name.as_str().ptr, pixels as i32)
            if font == null { panic("cannot load a font; check FONTCONFIG_FILE") }
            let vertex = shader(0x8b31, "#version 330 core\nlayout(location=0) in vec2 pos; layout(location=1) in vec2 tex; layout(location=2) in vec4 color; uniform vec2 screen; out vec2 uv; out vec4 tint; void main(){ gl_Position=vec4(pos.x/screen.x*2.0-1.0,1.0-pos.y/screen.y*2.0,0,1); uv=tex; tint=color; }")
            let fragment = shader(0x8b30, "#version 330 core\nin vec2 uv; in vec4 tint; uniform sampler2D atlas; out vec4 outColor; void main(){ float coverage=uv.x<0.0 ? 1.0 : texture(atlas,uv).r; outColor=vec4(tint.rgb,tint.a*coverage); }")
            let program = api.glCreateProgram()
            api.glAttachShader(program, vertex); api.glAttachShader(program, fragment)
            api.glLinkProgram(program)
            api.glDeleteShader(vertex); api.glDeleteShader(fragment)
            var okay: i32 = 0
            api.glGetProgramiv(program, 0x8b82, &okay)
            if okay == 0 {
                var log = [0 as u8; 2048]
                api.glGetProgramInfoLog(program, 2048, null, &log[0])
                println(ffi.copy_c_string(&log[0]))
                panic("OpenGL shader link failed")
            }
            var vao: u32 = 0; var vbo: u32 = 0; var texture: u32 = 0
            api.glGenVertexArrays(1, &vao); api.glBindVertexArray(vao)
            api.glGenBuffers(1, &vbo); api.glBindBuffer(0x8892, vbo)
            api.glEnableVertexAttribArray(0); api.glEnableVertexAttribArray(1); api.glEnableVertexAttribArray(2)
            api.glVertexAttribPointer(0, 2, 0x1406, 0, 32, null)
            api.glVertexAttribPointer(1, 2, 0x1406, 0, 32, 8 as *u8)
            api.glVertexAttribPointer(2, 4, 0x1406, 0, 32, 16 as *u8)
            api.glGenTextures(1, &texture); api.glBindTexture(0x0de1, texture)
            api.glTexParameteri(0x0de1, 0x2801, 0x2601); api.glTexParameteri(0x0de1, 0x2800, 0x2601)
            api.glTexParameteri(0x0de1, 0x2802, 0x812f); api.glTexParameteri(0x0de1, 0x2803, 0x812f)
            api.glPixelStorei(0x0cf5, 1)
            let zero = Vec(u8).filled(ATLAS as i64 * ATLAS as i64, 0)
            api.glTexImage2D(0x0de1, 0, 0x8229, ATLAS, ATLAS, 0, 0x1903, 0x1401, zero.as_slice().ptr)
            api.glEnable(0x0be2); api.glBlendFunc(0x0302, 0x0303)
            var out = Renderer { cell_width: api.banana_font_width(font) as i64,
                cell_height: pixels + pixels / 3, padding: (12.0 * scale) as i64,
                ascent: api.banana_font_ascent(font) as i64 + pixels / 8,
                font, shader: program, vao, vbo, texture,
                screen: api.glGetUniformLocation(program, "screen"), glyphs: Map(u32, Glyph).new(),
                atlas_x: 1, atlas_y: 1, atlas_row: 0, backgrounds: Vec(Vertex).new(), text: Vec(Vertex).new() }
            out.glyph('?' as u32)
            out
        }
    }

    fn glyph(inout self, cp: u32) -> Glyph {
        match self.glyphs.get(cp) { Some(g) => { return g }, None => {} }
        unsafe {
            let bitmap = api.banana_font_glyph(self.font, cp)
            if self.atlas_x + bitmap.width + 1 >= ATLAS {
                self.atlas_x = 1; self.atlas_y += self.atlas_row + 1; self.atlas_row = 0
            }
            if self.atlas_y + bitmap.height + 1 >= ATLAS || bitmap.width + 2 >= ATLAS {
                return self.glyphs['?' as u32]
            }
            let glyph = Glyph { x: self.atlas_x, y: self.atlas_y, w: bitmap.width,
                h: bitmap.height, left: bitmap.left, top: bitmap.top }
            if bitmap.width > 0 && bitmap.height > 0 && bitmap.pixels != null {
                api.glTexSubImage2D(0x0de1, 0, glyph.x, glyph.y, glyph.w, glyph.h, 0x1903, 0x1401, bitmap.pixels)
            }
            self.atlas_x += bitmap.width + 1
            if bitmap.height > self.atlas_row { self.atlas_row = bitmap.height }
            self.glyphs.insert(cp, glyph)
            glyph
        }
    }

    pub fn draw(inout self, term: terminal.Terminal, width: i32, height: i32, cursor: bool) {
        self.backgrounds.clear(); self.text.clear()
        unsafe {
            api.glViewport(0, 0, width, height)
            api.glClearColor(16.0 / 255.0, 21.0 / 255.0, 29.0 / 255.0, 1.0)
            api.glClear(0x4000)
            api.glUseProgram(self.shader)
            api.glUniform2f(self.screen, width as f32, height as f32)
            api.glBindVertexArray(self.vao)
            api.glBindBuffer(0x8892, self.vbo)
            api.glBindTexture(0x0de1, self.texture)
        }
        for y in 0..term.rows {
            for x in 0..term.cols {
                let cell = term.display_cell(x, y)
                var fg = cell.fg
                var bg = cell.bg
                if cell.attrs & 4 != 0 { fg = cell.bg; bg = cell.fg }
                let active = cursor && term.cursor_visible && term.view == 0 && term.x == x && term.y == y
                if active { bg = 0xf1ce78; fg = terminal.BACKGROUND }
                let px = (self.padding + x * self.cell_width) as f32
                let py = (self.padding + y * self.cell_height) as f32
                if bg != terminal.BACKGROUND {
                    quad(&self.backgrounds, px, py, self.cell_width as f32, self.cell_height as f32,
                        -1.0, 0.0, 0.0, 0.0, bg, 1.0)
                }
                if cell.cp > 32 && cell.width != 0 {
                    let g = self.glyph(cell.cp)
                    quad(&self.text, px + g.left as f32, py + (self.ascent - g.top as i64) as f32,
                        g.w as f32, g.h as f32, g.x as f32 / ATLAS as f32, g.y as f32 / ATLAS as f32,
                        g.w as f32 / ATLAS as f32, g.h as f32 / ATLAS as f32, fg, 1.0)
                    if cell.attrs & 1 != 0 {
                        quad(&self.text, px + g.left as f32 + 0.5, py + (self.ascent - g.top as i64) as f32,
                            g.w as f32, g.h as f32, g.x as f32 / ATLAS as f32, g.y as f32 / ATLAS as f32,
                            g.w as f32 / ATLAS as f32, g.h as f32 / ATLAS as f32, fg, 0.4)
                    }
                }
                if cell.attrs & 2 != 0 {
                    quad(&self.text, px, py + self.ascent as f32 + 2.0, self.cell_width as f32, 1.0,
                        -1.0, 0.0, 0.0, 0.0, fg, 1.0)
                }
            }
        }
        unsafe {
            let bg = self.backgrounds.as_slice()
            api.glBufferData(0x8892, bg.len * size_of(Vertex), bg.ptr as *u8, 0x88e0)
            api.glDrawArrays(4, 0, bg.len as i32)
            let text = self.text.as_slice()
            api.glBufferData(0x8892, text.len * size_of(Vertex), text.ptr as *u8, 0x88e0)
            api.glDrawArrays(4, 0, text.len as i32)
        }
    }

    pub fn screenshot(self, path: str, width: i32, height: i32) {
        var pixels = Vec(u8).filled(width as i64 * height as i64 * 4, 0)
        unsafe { api.glReadPixels(0, 0, width, height, 0x1908, 0x1401, &pixels[0]) }
        var ppm = String.from("P6\n")
        (width as i64).show(&ppm); ppm.push(' '); (height as i64).show(&ppm); ppm.push_str("\n255\n")
        var y = height as i64
        while y > 0 {
            y -= 1
            for x in 0..width as i64 {
                let i = (y * width as i64 + x) * 4
                ppm.push(pixels[i]); ppm.push(pixels[i + 1]); ppm.push(pixels[i + 2])
            }
        }
        match fs.write_file(path, ppm.as_str()) {
            Ok(_) => {}
            Err(message) => { println(message); panic("cannot save OpenGL framebuffer") }
        }
    }
}

impl Drop for Renderer {
    fn drop(inout self) {
        unsafe {
            api.banana_font_close(self.font)
            api.glDeleteProgram(self.shader)
            api.glDeleteBuffers(1, &self.vbo)
            api.glDeleteVertexArrays(1, &self.vao)
            api.glDeleteTextures(1, &self.texture)
        }
    }
}
