import api
import config
import std.ffi
import std.fs
import std.utf8
import terminal
import theme

const ATLAS: i32 = 2048

// Shape kinds, interpreted by the fragment shader.
const GLYPH: f32 = 0.0
const BOX: f32 = 1.0
const GLOW: f32 = 2.0
const BACKDROP: f32 = 3.0
const RING: f32 = 4.0

// Seconds a toast stays visible.
const TOAST: f64 = 1.6

// Position, atlas coordinates, color, the pixel's offset from the shape's
// center with the shape's half size, then corner radius, softness and kind.
struct Vertex {
    x: f32, y: f32, u: f32, v: f32, r: f32, g: f32, b: f32, a: f32,
    lx: f32, ly: f32, hw: f32, hh: f32, radius: f32, soft: f32, kind: f32, pad: f32
}
struct Glyph { x: i32, y: i32, w: i32, h: i32, left: i32, top: i32 }

// An offscreen color buffer for post-processing.
struct Target { fbo: u32, texture: u32 }

struct Effect {
    name: String
    path: String
    program: u32
    mtime: i64
    animated: bool
}

// Everything besides the terminal grid that a frame shows.
pub struct Frame {
    pub title: String
    pub segments: Vec(String)
    pub status_bar: bool
    pub focused: bool
    pub bell: f64
    pub cursor_style: i64
    pub cursor_blink: bool
    pub cursor_glow: bool
    pub cursor_trail: bool
    pub gradient: bool
    pub vignette: f32
    pub opacity: f32
    pub mouse_x: f32
    pub mouse_y: f32
    pub params: [f32; 8]
    // A short message shown at the top, such as the theme just chosen.
    pub toast: String
    pub toast_time: f64
}

pub struct Renderer {
    pub cell_width: i64
    pub cell_height: i64
    pub padding: i64
    pub bar_height: i64
    scale: f32
    font: *u8
    pixels: i64
    ascent: i64
    shader: u32
    screen: i32
    vao: u32
    vbo: u32
    texture: u32
    glyphs: Map(u32, Glyph)
    atlas_x: i32
    atlas_y: i32
    atlas_row: i32
    vertices: Vec(Vertex)
    // The cursor glides toward the cell it is in.
    cursor_x: f32
    cursor_y: f32
    cursor_w: f32
    cursor_placed: bool
    cursor_cell: (i64, i64)
    blink_epoch: f64
    last_time: f64
    drawn_alpha: f32
    frame_count: i64
    post_vao: u32
    targets: Vec(Target)
    target_width: i32
    target_height: i32
    effects: Vec(Effect)
    checked: f64
}

unsafe fn compile(kind: u32, source: str, label: str) -> u32 {
    let id = api.glCreateShader(kind)
    var p = source.ptr
    var length = source.len as i32
    api.glShaderSource(id, 1, &p, &length)
    api.glCompileShader(id)
    var okay: i32 = 0
    api.glGetShaderiv(id, 0x8b81, &okay)
    if okay == 0 {
        var log = [0 as u8; 4096]
        api.glGetShaderInfoLog(id, 4096, null, &log[0])
        eprintln("banana: " + label + ":")
        eprintln(ffi.copy_c_string(&log[0]))
        api.glDeleteShader(id)
        return 0
    }
    id
}

// A linked program, or 0 after printing why not.
unsafe fn link(vertex_source: str, fragment_source: str, label: str) -> u32 {
    let vertex = compile(0x8b31, vertex_source, label)
    if vertex == 0 { return 0 }
    let fragment = compile(0x8b30, fragment_source, label)
    if fragment == 0 { api.glDeleteShader(vertex); return 0 }
    let program = api.glCreateProgram()
    api.glAttachShader(program, vertex); api.glAttachShader(program, fragment)
    api.glLinkProgram(program)
    api.glDeleteShader(vertex); api.glDeleteShader(fragment)
    var okay: i32 = 0
    api.glGetProgramiv(program, 0x8b82, &okay)
    if okay == 0 {
        var log = [0 as u8; 4096]
        api.glGetProgramInfoLog(program, 4096, null, &log[0])
        eprintln("banana: " + label + ":")
        eprintln(ffi.copy_c_string(&log[0]))
        api.glDeleteProgram(program)
        return 0
    }
    program
}

const SCENE_VERTEX: str = comptime lines([
    "#version 330 core",
    "layout(location=0) in vec2 pos; layout(location=1) in vec2 tex; layout(location=2) in vec4 color;",
    "layout(location=3) in vec4 local; layout(location=4) in vec4 shape;",
    "uniform vec2 screen;",
    "out vec2 uv; out vec4 tint; out vec4 box; out vec4 form;",
    "void main() {",
    "    gl_Position = vec4(pos.x / screen.x * 2.0 - 1.0, 1.0 - pos.y / screen.y * 2.0, 0.0, 1.0);",
    "    uv = tex; tint = color; box = local; form = shape;",
    "}"
])

const SCENE_FRAGMENT: str = comptime lines([
    "#version 330 core",
    "in vec2 uv; in vec4 tint; in vec4 box; in vec4 form;",
    "uniform sampler2D atlas;",
    "out vec4 outColor;",
    "float rounded(vec2 p, vec2 half_size, float r) {",
    "    vec2 q = abs(p) - half_size + r;",
    "    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;",
    "}",
    "void main() {",
    "    float kind = form.z;",
    "    float coverage = 1.0;",
    "    vec3 rgb = tint.rgb;",
    "    if (kind < 0.5) {",
    "        // Slightly heavier strokes read better on dark backgrounds.",
    "        coverage = pow(texture(atlas, uv).r, 0.85);",
    "    } else if (kind < 1.5) {",
    "        coverage = clamp(0.5 - rounded(box.xy, box.zw, form.x), 0.0, 1.0);",
    "    } else if (kind < 2.5) {",
    "        float d = max(rounded(box.xy, box.zw, form.x), 0.0);",
    "        float g = 1.0 - smoothstep(0.0, form.y, d);",
    "        coverage = g * g;",
    "    } else if (kind < 3.5) {",
    "        vec2 n = box.xy / box.zw;",
    "        rgb *= 1.0 - form.y * 0.2 * dot(n, n);",
    "        // Dither the gradient so it does not band.",
    "        rgb += (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 255.0;",
    "    } else {",
    "        float d = rounded(box.xy, box.zw, form.x);",
    "        coverage = clamp(0.5 - abs(d + form.y * 0.5) + form.y * 0.5, 0.0, 1.0);",
    "    }",
    "    outColor = vec4(rgb, tint.a * coverage);",
    "}"
])

const POST_VERTEX: str = comptime lines([
    "#version 330 core",
    "out vec2 bananaUV;",
    "void main() {",
    "    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);",
    "    bananaUV = p;",
    "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);",
    "}"
])

// Shadertoy-style inputs. iChannel0 is the terminal, with premultiplied alpha.
const POST_PRELUDE: str = comptime lines([
    "#version 330 core",
    "uniform vec3 iResolution;",
    "uniform float iTime;",
    "uniform float iTimeDelta;",
    "uniform int iFrame;",
    "uniform vec4 iMouse;",
    "uniform sampler2D iChannel0;",
    "uniform vec4 iCursor;",
    "uniform vec3 iCursorColor;",
    "uniform vec3 iBackground;",
    "uniform vec3 iForeground;",
    "uniform vec3 iAccent;",
    "uniform float iOpacity;",
    "uniform float iParam[8];",
    "in vec2 bananaUV;",
    "out vec4 bananaFragColor;"
])

const POST_MAIN: str = comptime lines([
    "",
    "void main() {",
    "    vec4 color = vec4(0.0);",
    "    mainImage(color, gl_FragCoord.xy);",
    "    bananaFragColor = color;",
    "}"
])

fn lines(parts: [str]) -> String {
    var out = String.new()
    for p in parts { out.push_str(p); out.push('\n') }
    out
}

fn rgb(c: u32) -> (f32, f32, f32) {
    (((c >> 16) & 255) as f32 / 255.0, ((c >> 8) & 255) as f32 / 255.0, (c & 255) as f32 / 255.0)
}

// A shape covering (x, y, w, h), grown by `grow` pixels on each side for glows.
fn shape(inout vertices: Vec(Vertex), x: f32, y: f32, w: f32, h: f32, top: u32, bottom: u32,
    alpha: f32, radius: f32, soft: f32, kind: f32, grow: f32) {
    let (r0, g0, b0) = rgb(top)
    let (r1, g1, b1) = rgb(bottom)
    let hw = w / 2.0
    let hh = h / 2.0
    let ex = hw + grow
    let ey = hh + grow
    let cx = x + hw
    let cy = y + hh
    let a = Vertex { x: cx - ex, y: cy - ey, u: 0.0, v: 0.0, r: r0, g: g0, b: b0, a: alpha,
        lx: -ex, ly: -ey, hw, hh, radius, soft, kind, pad: 0.0 }
    let b = Vertex { x: cx + ex, y: cy - ey, u: 0.0, v: 0.0, r: r0, g: g0, b: b0, a: alpha,
        lx: ex, ly: -ey, hw, hh, radius, soft, kind, pad: 0.0 }
    let c = Vertex { x: cx + ex, y: cy + ey, u: 0.0, v: 0.0, r: r1, g: g1, b: b1, a: alpha,
        lx: ex, ly: ey, hw, hh, radius, soft, kind, pad: 0.0 }
    let d = Vertex { x: cx - ex, y: cy + ey, u: 0.0, v: 0.0, r: r1, g: g1, b: b1, a: alpha,
        lx: -ex, ly: ey, hw, hh, radius, soft, kind, pad: 0.0 }
    vertices.push(a); vertices.push(b); vertices.push(c)
    vertices.push(a); vertices.push(c); vertices.push(d)
}

fn rect(inout vertices: Vec(Vertex), x: f32, y: f32, w: f32, h: f32, color: u32, alpha: f32, radius: f32) {
    shape(&vertices, x, y, w, h, color, color, alpha, radius, 0.0, BOX, 0.0)
}

fn sprite(inout vertices: Vec(Vertex), x: f32, y: f32, g: Glyph, color: u32, alpha: f32) {
    let (r, gr, b) = rgb(color)
    let w = g.w as f32
    let h = g.h as f32
    let u = g.x as f32 / ATLAS as f32
    let v = g.y as f32 / ATLAS as f32
    let uw = w / ATLAS as f32
    let vh = h / ATLAS as f32
    let a = Vertex { x, y, u, v, r, g: gr, b, a: alpha, lx: 0.0, ly: 0.0, hw: 0.0, hh: 0.0,
        radius: 0.0, soft: 0.0, kind: GLYPH, pad: 0.0 }
    let bv = Vertex { x: x + w, y, u: u + uw, v, r, g: gr, b, a: alpha, lx: 0.0, ly: 0.0, hw: 0.0, hh: 0.0,
        radius: 0.0, soft: 0.0, kind: GLYPH, pad: 0.0 }
    let c = Vertex { x: x + w, y: y + h, u: u + uw, v: v + vh, r, g: gr, b, a: alpha, lx: 0.0, ly: 0.0,
        hw: 0.0, hh: 0.0, radius: 0.0, soft: 0.0, kind: GLYPH, pad: 0.0 }
    let d = Vertex { x, y: y + h, u, v: v + vh, r, g: gr, b, a: alpha, lx: 0.0, ly: 0.0, hw: 0.0, hh: 0.0,
        radius: 0.0, soft: 0.0, kind: GLYPH, pad: 0.0 }
    vertices.push(a); vertices.push(bv); vertices.push(c)
    vertices.push(a); vertices.push(c); vertices.push(d)
}

fn smooth(x: f64) -> f32 {
    let t = if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }
    (t * t * (3.0 - 2.0 * t)) as f32
}

fn absf(x: f32) -> f32 { if x < 0.0 { -x } else { x } }

fn modulo(x: f64, period: f64) -> f64 { x - floor(x / period) * period }

impl Renderer {
    pub fn new(family: str, size: i64, scale: f32, padding: i64, line_height: f32) -> Renderer {
        let name = ffi.c_string(family).unwrap()
        let pixels = terminal.clamp((size as f32 * scale) as i64, 6, 160)
        unsafe {
            let font = api.banana_font_open(name.as_str().ptr, pixels as i32)
            if font == null { panic("cannot load a font; check FONTCONFIG_FILE") }
            let program = link(SCENE_VERTEX, SCENE_FRAGMENT, "terminal shader")
            if program == 0 { panic("OpenGL shader compilation failed") }
            var vao: u32 = 0; var vbo: u32 = 0; var texture: u32 = 0; var post_vao: u32 = 0
            api.glGenVertexArrays(1, &post_vao)
            api.glGenVertexArrays(1, &vao); api.glBindVertexArray(vao)
            api.glGenBuffers(1, &vbo); api.glBindBuffer(0x8892, vbo)
            for i in 0..5 { api.glEnableVertexAttribArray(i as u32) }
            api.glVertexAttribPointer(0, 2, 0x1406, 0, 64, null)
            api.glVertexAttribPointer(1, 2, 0x1406, 0, 64, 8 as *u8)
            api.glVertexAttribPointer(2, 4, 0x1406, 0, 64, 16 as *u8)
            api.glVertexAttribPointer(3, 4, 0x1406, 0, 64, 32 as *u8)
            api.glVertexAttribPointer(4, 4, 0x1406, 0, 64, 48 as *u8)
            api.glGenTextures(1, &texture); api.glBindTexture(0x0de1, texture)
            api.glTexParameteri(0x0de1, 0x2801, 0x2601); api.glTexParameteri(0x0de1, 0x2800, 0x2601)
            api.glTexParameteri(0x0de1, 0x2802, 0x812f); api.glTexParameteri(0x0de1, 0x2803, 0x812f)
            api.glPixelStorei(0x0cf5, 1)
            let zero = Vec(u8).filled(ATLAS as i64 * ATLAS as i64, 0)
            api.glTexImage2D(0x0de1, 0, 0x8229, ATLAS, ATLAS, 0, 0x1903, 0x1401, zero.as_slice().ptr)
            let ascent = api.banana_font_ascent(font) as i64
            let descent = api.banana_font_descent(font) as i64
            let cell_height = terminal.clamp((pixels as f32 * line_height) as i64, ascent + descent, 1000)
            let cell_width = api.banana_font_width(font) as i64
            var out = Renderer { cell_width, cell_height,
                padding: (padding as f32 * scale) as i64,
                bar_height: cell_height + (scale * 10.0) as i64, scale, font, pixels,
                // Center the font's ascent and descent in the line.
                ascent: ascent + (cell_height - ascent - descent) / 2,
                shader: program, screen: api.glGetUniformLocation(program, "screen"),
                vao, vbo, texture, glyphs: Map(u32, Glyph).new(),
                atlas_x: 1, atlas_y: 1, atlas_row: 0, vertices: Vec(Vertex).new(),
                cursor_x: 0.0, cursor_y: 0.0, cursor_w: 0.0, cursor_placed: false,
                cursor_cell: (-1, -1), blink_epoch: 0.0, last_time: 0.0, drawn_alpha: -1.0,
                frame_count: 0, post_vao, targets: Vec(Target).new(), target_width: 0,
                target_height: 0, effects: Vec(Effect).new(), checked: 0.0 }
            out.glyph('?' as u32, 0)
            out
        }
    }

    fn glyph(inout self, cp: u32, style: i64) -> Glyph {
        let key = cp | ((style as u32) << 22)
        match self.glyphs.get(key) { Some(g) => { return g }, None => {} }
        unsafe {
            let bitmap = api.banana_font_glyph(self.font, cp, style as i32)
            if self.atlas_x + bitmap.width + 1 >= ATLAS {
                self.atlas_x = 1; self.atlas_y += self.atlas_row + 1; self.atlas_row = 0
            }
            if self.atlas_y + bitmap.height + 1 >= ATLAS || bitmap.width + 2 >= ATLAS {
                return self.glyphs['?' as u32]
            }
            let glyph = Glyph { x: self.atlas_x, y: self.atlas_y, w: bitmap.width,
                h: bitmap.height, left: bitmap.left, top: bitmap.top }
            if bitmap.width > 0 && bitmap.height > 0 && bitmap.pixels != null {
                api.glBindTexture(0x0de1, self.texture)
                api.glTexSubImage2D(0x0de1, 0, glyph.x, glyph.y, glyph.w, glyph.h, 0x1903, 0x1401, bitmap.pixels)
            }
            self.atlas_x += bitmap.width + 1
            if bitmap.height > self.atlas_row { self.atlas_row = bitmap.height }
            self.glyphs.insert(key, glyph)
            glyph
        }
    }

    // Draws one character whose cell starts at (x, y) and spans `cells` cells.
    fn character(inout self, x: f32, y: f32, cp: u32, style: i64, cells: i64, color: u32, alpha: f32) {
        let g = self.glyph(cp, style)
        if g.w == 0 || g.h == 0 { return }
        let span = (self.cell_width * cells) as f32
        // Fallback fonts rarely match the cell; center wide glyphs in their span.
        var gx = x + g.left as f32
        if cells > 1 || g.w as f32 > span { gx = x + floor((span - g.w as f32) / 2.0) }
        sprite(&self.vertices, gx, y + (self.ascent - g.top as i64) as f32, g, color, alpha)
    }

    // Draws UTF-8 text in cells from (x, y); returns the width used.
    fn label(inout self, x: f32, y: f32, text: str, color: u32, style: i64) -> f32 {
        var px = x
        for scalar in text.chars() {
            match scalar {
                Ok(cp) => {
                    let cells = terminal.char_width(cp)
                    if cells > 0 {
                        if cp > 32 { self.character(px, y, cp, style, cells, color, 1.0) }
                        px += (self.cell_width * cells) as f32
                    }
                }
                Err(_) => {}
            }
        }
        px - x
    }

    fn text_width(self, text: str) -> f32 {
        var cells: i64 = 0
        for scalar in text.chars() {
            match scalar { Ok(cp) => { cells += terminal.char_width(cp) }, Err(_) => {} }
        }
        (cells * self.cell_width) as f32
    }

    fn cursor_shape(self, term: terminal.Terminal, frame: Frame) -> i64 {
        var s = if term.cursor_shape == 0 { frame.cursor_style } else { term.cursor_shape }
        if s == 0 { s = 2 }
        // The configured blink setting picks between the blinking and steady forms.
        if term.cursor_shape == 0 && frame.cursor_blink && s % 2 == 0 { s -= 1 }
        if term.cursor_shape == 0 && !frame.cursor_blink && s % 2 == 1 { s += 1 }
        // An unfocused window keeps a still, hollow cursor.
        if !frame.focused && s % 2 == 1 { s += 1 }
        s
    }

    fn blink_alpha(self, shape: i64, time: f64) -> f32 {
        if shape % 2 == 0 { return 1.0 }
        let t = time - self.blink_epoch
        // Stay solid while the user types, and stop blinking when idle.
        if t < 0.6 || t > 30.0 { return 1.0 }
        let p = modulo(t - 0.6, 1.1)
        if p < 0.45 { 1.0 } else if p < 0.6 { (1.0 as f32) - smooth((p - 0.45) / 0.15) }
        else if p < 0.95 { 0.0 } else { smooth((p - 0.95) / 0.15) }
    }

    fn cursor_target(self, term: terminal.Terminal) -> (f32, f32, f32) {
        let cell = term.display_cell(term.x, term.y)
        let cells = if cell.width == 2 { 2 } else { 1 }
        ((self.padding + term.x * self.cell_width) as f32, (self.padding + term.y * self.cell_height) as f32,
            (self.cell_width * cells) as f32)
    }

    // Whether time alone changes the next frame: animations and blinking.
    pub fn animating(self, term: terminal.Terminal, frame: Frame, time: f64) -> bool {
        for effect in self.effects { if effect.animated { return true } }
        if frame.bell >= 0.0 && time - frame.bell < 0.35 { return true }
        if !frame.toast.is_empty() && time - frame.toast_time < TOAST + 0.1 { return true }
        if term.cursor_visible && term.view == 0 {
            let (tx, ty, tw) = self.cursor_target(term)
            if absf(tx - self.cursor_x) > 0.5 || absf(ty - self.cursor_y) > 0.5 || absf(tw - self.cursor_w) > 0.5 {
                return true
            }
            let a = self.blink_alpha(self.cursor_shape(term, frame), time)
            if absf(a - self.drawn_alpha) > 0.01 { return true }
        }
        false
    }

    pub fn draw(inout self, term: terminal.Terminal, th: theme.Theme, frame: Frame, width: i32, height: i32, time: f64) {
        self.vertices.clear()
        let dt = if self.last_time > 0.0 { time - self.last_time } else { 0.0 }
        self.last_time = time
        let cw = self.cell_width as f32
        let ch = self.cell_height as f32
        let pad = self.padding as f32
        let s = self.scale
        let w = width as f32
        let h = height as f32

        let end = if frame.gradient { th.background_end } else { th.background }
        shape(&self.vertices, 0.0, 0.0, w, h, th.background, end, frame.opacity, 0.0,
            if frame.gradient { frame.vignette } else { 0.0 }, BACKDROP, 0.0)

        // Cell backgrounds, merged into runs, then selections as rounded bands.
        for y in 0..term.rows {
            let py = pad + (y * self.cell_height) as f32
            var run_start: i64 = 0
            var run_color: u32 = th.background
            for x in 0..term.cols + 1 {
                var bg = th.background
                if x < term.cols {
                    let cell = term.display_cell(x, y)
                    bg = if cell.attrs & 4 != 0 { th.resolve(cell.fg) } else { th.resolve(cell.bg) }
                }
                if bg != run_color || x == term.cols {
                    if run_color != th.background && x > run_start {
                        rect(&self.vertices, pad + (run_start * self.cell_width) as f32, py,
                            ((x - run_start) * self.cell_width) as f32, ch, run_color, 1.0, 0.0)
                    }
                    run_start = x
                    run_color = bg
                }
            }
            var sel_start: i64 = -1
            for x in 0..term.cols + 1 {
                let selected = x < term.cols && term.is_selected(x, y)
                if selected && sel_start < 0 { sel_start = x }
                if !selected && sel_start >= 0 {
                    rect(&self.vertices, pad + (sel_start * self.cell_width) as f32 - 1.0, py + 1.0,
                        ((x - sel_start) * self.cell_width) as f32 + 2.0, ch - 2.0, th.selection, 1.0, ch * 0.22)
                    sel_start = -1
                }
            }
        }

        // The cursor eases toward its cell instead of jumping.
        let show_cursor = term.cursor_visible && term.view == 0
        let cursor_shape = self.cursor_shape(term, frame)
        let (tx, ty, tw) = self.cursor_target(term)
        if term.x != self.cursor_cell.0 || term.y != self.cursor_cell.1 {
            self.cursor_cell = (term.x, term.y)
            self.blink_epoch = time
        }
        if !self.cursor_placed || !frame.cursor_trail {
            self.cursor_x = tx; self.cursor_y = ty; self.cursor_w = tw; self.cursor_placed = true
        } else {
            let k = config.clampf((dt * 24.0) as f32, 0.0, 1.0)
            self.cursor_x += (tx - self.cursor_x) * k
            self.cursor_y += (ty - self.cursor_y) * k
            self.cursor_w += (tw - self.cursor_w) * k
            if absf(tx - self.cursor_x) < 0.5 && absf(ty - self.cursor_y) < 0.5 { self.cursor_x = tx; self.cursor_y = ty }
            if absf(tw - self.cursor_w) < 0.5 { self.cursor_w = tw }
        }
        let alpha = if show_cursor { self.blink_alpha(cursor_shape, time) } else { 0.0 }
        self.drawn_alpha = alpha
        let block = cursor_shape <= 2 && frame.focused
        if alpha > 0.0 {
            let cx = self.cursor_x
            let cy = self.cursor_y
            let cwid = self.cursor_w
            if frame.cursor_glow && frame.focused {
                shape(&self.vertices, cx, cy, cwid, ch, th.cursor, th.cursor, alpha * 0.22, s * 3.0,
                    ch * 0.9, GLOW, ch * 0.9)
            }
            if !frame.focused {
                shape(&self.vertices, cx, cy, cwid, ch, th.cursor, th.cursor, alpha, s * 2.5,
                    config.clampf(s * 1.5, 1.0, 4.0), RING, 0.0)
            } else if cursor_shape <= 2 {
                rect(&self.vertices, cx, cy, cwid, ch, th.cursor, alpha, config.clampf(cw * 0.2, 1.0, s * 6.0))
            } else if cursor_shape <= 4 {
                let t = config.clampf(s * 2.0, 1.0, 6.0)
                rect(&self.vertices, cx, cy + ch - t - 1.0, cwid, t, th.cursor, alpha, t / 2.0)
            } else {
                let t = config.clampf(s * 2.0, 1.0, 6.0)
                rect(&self.vertices, cx, cy + 1.0, t, ch - 2.0, th.cursor, alpha, t / 2.0)
            }
        }

        // Text, with decorations.
        for y in 0..term.rows {
            let py = pad + (y * self.cell_height) as f32
            for x in 0..term.cols {
                let cell = term.display_cell(x, y)
                var fg = th.resolve(cell.fg)
                if cell.attrs & 4 != 0 { fg = th.resolve(cell.bg) }
                if term.is_selected(x, y) { fg = th.selection_text }
                let under_cursor = show_cursor && block && alpha > 0.5 && x == term.x && y == term.y
                if under_cursor { fg = th.cursor_text }
                let px = pad + (x * self.cell_width) as f32
                let fade: f32 = if cell.attrs & 8 != 0 { 0.55 } else { 1.0 }
                if cell.cp > 32 && cell.width != 0 && cell.attrs & 64 == 0 {
                    let style = (cell.attrs & 1) + (if cell.attrs & 16 != 0 { 2 } else { 0 })
                    self.character(px, py, cell.cp, style, cell.width, fg, fade)
                }
                let thick = config.clampf(floor(s + 0.5), 1.0, 4.0)
                if cell.attrs & 2 != 0 {
                    rect(&self.vertices, px, py + (self.ascent as f32) + s * 2.0, cw, thick, fg, fade, 0.0)
                }
                if cell.attrs & 32 != 0 {
                    rect(&self.vertices, px, py + (self.ascent as f32) - (self.pixels as f32) * 0.3, cw, thick, fg, fade, 0.0)
                }
            }
        }

        // A slim scrollbar while looking at history.
        if term.view > 0 && term.history.len() > 0 {
            let track = (term.rows * self.cell_height) as f32
            let total = (term.history.len() + term.rows) as f32
            let thumb = config.clampf(track * term.rows as f32 / total, ch, track)
            let offset = (track - thumb) * (term.history.len() - term.view) as f32 / term.history.len() as f32
            let bw = config.clampf(s * 4.0, 2.0, 12.0)
            rect(&self.vertices, w - pad / 2.0 - bw / 2.0, pad + offset, bw, thumb, th.foreground, 0.35, bw / 2.0)
        }

        if frame.status_bar {
            let top = h - self.bar_height as f32
            rect(&self.vertices, 0.0, top, w, self.bar_height as f32, th.bar, frame.opacity, 0.0)
            rect(&self.vertices, 0.0, top, w, config.clampf(s, 1.0, 2.0), th.foreground, 0.06, 0.0)
            let inset = (self.bar_height - self.cell_height) as f32 / 2.0
            let pill_h = self.bar_height as f32 - inset
            let pill_y = top + inset / 2.0
            let text_y = top + inset
            let gap = cw * 0.75
            // Left: a pill with the window title.
            var left = String.from("❯ ")
            if frame.title.is_empty() { left.push_str("banana") } else { left.push_str(frame.title.as_str()) }
            let max_left = w / 2.0
            var title = left.as_str()
            var title_w = self.text_width(title)
            while title_w > max_left && title.len > 1 {
                var cut = title.len - 1
                while cut > 0 && title[cut] & 0xc0 == 0x80 { cut -= 1 }
                title = title[0..cut]
                title_w = self.text_width(title)
            }
            rect(&self.vertices, pad / 2.0, pill_y, title_w + 2.0 * gap, pill_h, th.accent, 1.0, pill_h / 2.0)
            self.label(pad / 2.0 + gap, text_y, title, th.cursor_text, 1)
            // Right: plugin segments, last one at the edge.
            var x = w - pad / 2.0
            var i = frame.segments.len()
            while i > 0 {
                i -= 1
                let seg = frame.segments[i].as_str()
                if seg.len == 0 { continue }
                let sw = self.text_width(seg)
                x -= sw + 2.0 * gap
                if x < pad / 2.0 + title_w + 3.0 * gap { break }
                rect(&self.vertices, x, pill_y, sw + 2.0 * gap, pill_h, th.foreground, 0.08, pill_h / 2.0)
                self.label(x + gap, text_y, seg, th.bar_text, 0)
                x -= gap / 2.0
            }
        }

        let toast_age = time - frame.toast_time
        if !frame.toast.is_empty() && toast_age < TOAST {
            let fade_in = smooth(toast_age / 0.15)
            let fade = fade_in * ((1.0 as f32) - smooth((toast_age - (TOAST - 0.4)) / 0.4))
            let message = frame.toast.as_str()
            let tw = self.text_width(message)
            let bw = tw + cw * 2.5
            let bh = ch * 1.6
            let bx = floor((w - bw) / 2.0)
            let by = pad + (1.0 - fade_in) * -8.0 * s
            shape(&self.vertices, bx, by, bw, bh, 0x000000, 0x000000, fade * 0.35, bh / 2.0, ch, GLOW, ch * 0.6)
            rect(&self.vertices, bx, by, bw, bh, th.bar, fade * 0.96, bh / 2.0)
            shape(&self.vertices, bx, by, bw, bh, th.accent, th.accent, fade * 0.8, bh / 2.0,
                config.clampf(s * 1.5, 1.0, 3.0), RING, 0.0)
            let start = self.vertices.len()
            self.label(bx + cw * 1.25, by + (bh - ch) / 2.0, message, th.foreground, 1)
            for i in start..self.vertices.len() { self.vertices[i].a = fade }
        }

        if frame.bell >= 0.0 && time - frame.bell < 0.35 {
            let fade: f32 = 1.0 - smooth((time - frame.bell) / 0.35)
            shape(&self.vertices, 0.0, 0.0, w, h, th.accent, th.accent, 0.12 * fade, 0.0, 0.0, BOX, 0.0)
        }

        unsafe {
            let chain = self.effects.len() > 0
            if chain { self.prepare_targets(width, height) }
            api.glBindFramebuffer(0x8d40, if chain { self.targets[0].fbo } else { 0 })
            api.glViewport(0, 0, width, height)
            api.glClearColor(0.0, 0.0, 0.0, 0.0)
            api.glClear(0x4000)
            api.glEnable(0x0be2)
            api.glBlendFuncSeparate(0x0302, 0x0303, 1, 0x0303)
            api.glUseProgram(self.shader)
            api.glUniform2f(self.screen, w, h)
            api.glActiveTexture(0x84c0)
            api.glBindVertexArray(self.vao)
            api.glBindBuffer(0x8892, self.vbo)
            api.glBindTexture(0x0de1, self.texture)
            let vs = self.vertices.as_slice()
            api.glBufferData(0x8892, vs.len * size_of(Vertex), vs.ptr as *u8, 0x88e0)
            api.glDrawArrays(4, 0, vs.len as i32)
            if chain {
                api.glDisable(0x0be2)
                api.glBindVertexArray(self.post_vao)
                let n = self.effects.len()
                for i in 0..n {
                    let source = self.targets[i % 2].texture
                    api.glBindFramebuffer(0x8d40, if i == n - 1 { 0 } else { self.targets[(i + 1) % 2].fbo })
                    api.glViewport(0, 0, width, height)
                    let p = self.effects[i].program
                    api.glUseProgram(p)
                    api.glBindTexture(0x0de1, source)
                    api.glUniform3f(api.glGetUniformLocation(p, "iResolution"), w, h, 1.0)
                    api.glUniform1f(api.glGetUniformLocation(p, "iTime"), time as f32)
                    api.glUniform1f(api.glGetUniformLocation(p, "iTimeDelta"), dt as f32)
                    api.glUniform1i(api.glGetUniformLocation(p, "iFrame"), self.frame_count as i32)
                    api.glUniform1i(api.glGetUniformLocation(p, "iChannel0"), 0)
                    api.glUniform4f(api.glGetUniformLocation(p, "iMouse"), frame.mouse_x, h - frame.mouse_y, 0.0, 0.0)
                    api.glUniform4f(api.glGetUniformLocation(p, "iCursor"), self.cursor_x, h - self.cursor_y - ch,
                        self.cursor_w, if show_cursor { ch } else { 0.0 })
                    let (cr, cg, cb) = rgb(th.cursor)
                    api.glUniform3f(api.glGetUniformLocation(p, "iCursorColor"), cr, cg, cb)
                    let (br, bgc, bb) = rgb(th.background)
                    api.glUniform3f(api.glGetUniformLocation(p, "iBackground"), br, bgc, bb)
                    let (fr, fgc, fb) = rgb(th.foreground)
                    api.glUniform3f(api.glGetUniformLocation(p, "iForeground"), fr, fgc, fb)
                    let (ar, ag, ab) = rgb(th.accent)
                    api.glUniform3f(api.glGetUniformLocation(p, "iAccent"), ar, ag, ab)
                    api.glUniform1f(api.glGetUniformLocation(p, "iOpacity"), frame.opacity)
                    api.glUniform1fv(api.glGetUniformLocation(p, "iParam"), 8, &frame.params[0])
                    api.glDrawArrays(4, 0, 3)
                }
                api.glBindTexture(0x0de1, self.texture)
                api.glEnable(0x0be2)
            }
        }
        self.frame_count += 1
    }

    unsafe fn prepare_targets(inout self, width: i32, height: i32) {
        let needed = if self.effects.len() > 1 { 2 } else { 1 }
        if self.target_width == width && self.target_height == height && self.targets.len() >= needed { return }
        self.release_targets()
        for _ in 0..needed {
            var fbo: u32 = 0; var texture: u32 = 0
            api.glGenTextures(1, &texture); api.glBindTexture(0x0de1, texture)
            api.glTexParameteri(0x0de1, 0x2801, 0x2601); api.glTexParameteri(0x0de1, 0x2800, 0x2601)
            api.glTexParameteri(0x0de1, 0x2802, 0x812f); api.glTexParameteri(0x0de1, 0x2803, 0x812f)
            api.glTexImage2D(0x0de1, 0, 0x8058, width, height, 0, 0x1908, 0x1401, null)
            api.glGenFramebuffers(1, &fbo); api.glBindFramebuffer(0x8d40, fbo)
            api.glFramebufferTexture2D(0x8d40, 0x8ce0, 0x0de1, texture, 0)
            if api.glCheckFramebufferStatus(0x8d40) != 0x8cd5 { panic("cannot create an OpenGL framebuffer") }
            self.targets.push(Target { fbo, texture })
        }
        api.glBindFramebuffer(0x8d40, 0)
        api.glBindTexture(0x0de1, self.texture)
        self.target_width = width
        self.target_height = height
    }

    unsafe fn release_targets(inout self) {
        for t in self.targets {
            api.glDeleteFramebuffers(1, &t.fbo)
            api.glDeleteTextures(1, &t.texture)
        }
        self.targets.clear()
        self.target_width = 0
    }

    // Replaces the post-processing chain. Shaders that fail to compile are skipped.
    pub fn set_effects(inout self, names: Vec(String)) {
        unsafe {
            for e in self.effects { api.glDeleteProgram(e.program) }
            self.effects.clear()
            for name in names {
                match config.search("shaders", name.as_str(), ".glsl") {
                    Some(path) => {
                        let mtime = mtime(path.as_str())
                        match build_effect(path.as_str()) {
                            Some((program, animated)) => self.effects.push(Effect { name: name.clone(),
                                path, program, mtime, animated })
                            None => eprintln("banana: shader skipped: " + name.as_str())
                        }
                    }
                    None => eprintln("banana: shader not found: " + name.as_str())
                }
            }
            self.release_targets()
        }
    }

    pub fn effect_names(self) -> String {
        var out = String.new()
        for e in self.effects {
            if !out.is_empty() { out.push_str(" + ") }
            out.push_str(e.name.as_str())
        }
        out
    }

    // Recompiles shaders whose files changed; returns whether one did.
    pub fn reload_effects(inout self, time: f64, force: bool) -> bool {
        if !force && time - self.checked < 0.5 { return false }
        self.checked = time
        var changed = false
        for i in 0..self.effects.len() {
            let now = mtime(self.effects[i].path.as_str())
            if !force && now == self.effects[i].mtime { continue }
            self.effects[i].mtime = now
            unsafe {
                match build_effect(self.effects[i].path.as_str()) {
                    Some((program, animated)) => {
                        api.glDeleteProgram(self.effects[i].program)
                        self.effects[i].program = program
                        self.effects[i].animated = animated
                        eprintln("banana: reloaded shader " + self.effects[i].name.as_str())
                        changed = true
                    }
                    None => eprintln("banana: keeping the previous " + self.effects[i].name.as_str())
                }
            }
        }
        changed
    }

    pub fn screenshot(self, path: str, width: i32, height: i32) {
        var pixels = Vec(u8).filled(width as i64 * height as i64 * 4, 0)
        unsafe {
            api.glBindFramebuffer(0x8d40, 0)
            api.glReadPixels(0, 0, width, height, 0x1908, 0x1401, &pixels[0])
        }
        var ppm = String.from("P6\n")
        (width as i64).show(&ppm); ppm.push(' '); (height as i64).show(&ppm); ppm.push_str("\n255\n")
        var y = height as i64
        while y > 0 {
            y -= 1
            for x in 0..width as i64 {
                let i = (y * width as i64 + x) * 4
                ppm.push(pixels[i]); ppm.push(pixels[i + 1]); ppm.push(pixels[i + 2])
            }
        }
        match fs.write_bytes(path, ppm.as_bytes()) {
            Ok(_) => {}
            Err(message) => { println(message); panic("cannot save OpenGL framebuffer") }
        }
    }
}

fn mtime(path: str) -> i64 {
    let c = match ffi.c_string(path) { Ok(c) => c, Err(_) => { return -1 } }
    unsafe { api.banana_file_mtime(c.as_str().ptr) }
}

// A post-processing program from a Shadertoy-style `mainImage` file.
unsafe fn build_effect(path: str) -> Option((u32, bool)) {
    let source = match fs.read_file(path) {
        Ok(text) => text
        Err(e) => { eprintln("banana: cannot read " + path); return None }
    }
    var body = source.as_str()
    // The prelude supplies the version; drop the file's own.
    if body.trim().starts_with("#version") {
        match body.find("\n") { Some(i) => { body = body[i + 1..] }, None => { body = "" } }
    }
    var full = String.from(POST_PRELUDE)
    full.push_str("#line 1\n")
    full.push_str(body)
    full.push_str(POST_MAIN)
    let program = link(POST_VERTEX, full.as_str(), path)
    if program == 0 { return None }
    Some((program, body.contains("iTime")))
}
