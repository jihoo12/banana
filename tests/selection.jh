import input
import terminal

fn check(ok: bool, message: str) { if !ok { panic(message) } }

fn select(inout t: terminal.Terminal, x: i64, y: i64, end_x: i64, end_y: i64) {
    t.start_selection(x, y)
    t.update_selection(end_x, end_y)
    t.selecting = false
}

fn main() {
    var t = terminal.Terminal.new(12, 4)
    t.feed("hello world\r\n  안녕 Z\r\nlast")
    select(&t, 1, 0, 5, 0)
    check(t.selection_text().as_str() == "ello", "forward selection")
    check(!t.is_selected(0, 0) && t.is_selected(1, 0) && t.is_selected(4, 0) && !t.is_selected(5, 0), "half-open highlight")
    select(&t, 5, 0, 1, 0)
    check(t.selection_text().as_str() == "ello", "reverse selection")
    select(&t, 6, 0, 4, 2)
    check(t.selection_text().as_str() == "world\n  안녕 Z\nlast", "multiline UTF-8 and line-end padding")
    select(&t, 4, 2, 6, 0)
    check(t.selection_text().as_str() == "world\n  안녕 Z\nlast", "reverse multiline selection")
    select(&t, 3, 1, 4, 1)
    check(t.selection_text().as_str() == "안", "select trailing half of Hangul")
    check(t.is_selected(2, 1) && t.is_selected(3, 1) && !t.is_selected(4, 1), "highlight both halves of Hangul")
    select(&t, 4, 1, 5, 1)
    check(t.selection_text().as_str() == "녕", "select leading half of Hangul")
    t.start_selection(3, 0)
    check(!t.has_selection() && t.selection_text().is_empty(), "click clears previous selection")
    t.clear_selection()
    t.update_selection(8, 0)
    check(!t.has_selection(), "mouse movement without a drag")
    select(&t, -10, -10, 100, 100)
    check(t.selection_text().as_str() == "hello world\n  안녕 Z\nlast\n", "drag outside grid clamps safely")
    select(&t, 11, 0, 0, 1)
    check(t.selection_text().as_str() == "\n", "selection of a hard newline")
    select(&t, 0, 0, 12, 0)
    check(t.selection_text().as_str() == "hello world", "right edge does not add a newline")

    var wrapped = terminal.Terminal.new(5, 4)
    wrapped.feed("abc defghij\r\nZ")
    select(&wrapped, 0, 0, 1, 3)
    check(wrapped.selection_text().as_str() == "abc defghij\nZ", "soft wraps join while hard newline remains")
    var spaces = terminal.Terminal.new(4, 3)
    spaces.feed("ab  cd")
    select(&spaces, 0, 0, 2, 1)
    check(spaces.selection_text().as_str() == "ab  cd", "spaces at soft wraps are preserved")
    spaces.feed("\x1b[H\x1b[2K")
    select(&spaces, 0, 0, 2, 1)
    check(spaces.selection_text().as_str() == "\ncd", "erase removes stale wrap metadata")
    var wide = terminal.Terminal.new(5, 3)
    wide.feed("abcd가😀")
    select(&wide, 0, 0, 4, 1)
    check(wide.selection_text().as_str() == "abcd가😀", "wide-character wrap skips unused padding and encodes four-byte UTF-8")

    var history = terminal.Terminal.new(8, 2)
    history.feed("one\r\ntwo\r\nthree")
    history.scroll_view(1)
    select(&history, 0, 0, 3, 1)
    check(history.selection_text().as_str() == "one\ntwo", "copy spans history and live grid")
    history.scroll_view(-1)
    check(history.is_selected(0, 0) && !history.is_selected(0, 1), "selection stays attached to scrolled text")
    history.feed("\r\nfour")
    check(history.selection_text().as_str() == "one\ntwo", "new output preserves selected history")
    history.scroll_view(2)
    history.start_selection(0, 0)
    history.scroll_view(-1)
    history.update_selection(5, 1)
    check(history.selection_text().as_str() == "one\ntwo\nthree", "wheel scrolling extends an active drag")
    history.selecting = false
    history.feed("\x1b[3J")
    check(!history.has_selection(), "history erasure invalidates selection")
    select(&history, 0, 0, 5, 0)
    history.feed("\x1b[?1049hALT")
    check(!history.has_selection(), "alternate screen clears primary selection")
    select(&history, 0, 0, 3, 0)
    check(history.selection_text().as_str() == "ALT", "alternate screen selection")
    history.feed("\x1b[?1049l")
    check(!history.has_selection(), "leaving alternate screen clears selection")
    select(&history, 0, 0, 3, 0)
    history.resize(10, 3)
    check(!history.has_selection(), "resize clears selection")
    select(&history, 0, 0, 3, 0)
    history.feed("\x1b[Hnew")
    check(!history.has_selection(), "overwriting selected cells clears selection")
    select(&history, 0, 0, 3, 0)
    history.feed("\x1b[H\x1b[P")
    check(!history.has_selection(), "deleting selected characters clears selection")
    select(&history, 0, 0, 3, 0)
    history.feed("\x1b[H\x1b[@")
    check(!history.has_selection(), "inserting into selected characters clears selection")
    select(&history, 0, 0, 3, 0)
    history.feed("\x1bc")
    check(!history.has_selection(), "terminal reset clears selection")

    var bounded = terminal.Terminal.new(4, 1)
    bounded.feed("old")
    select(&bounded, 0, 0, 3, 0)
    for _ in 0..terminal.HISTORY_LIMIT { bounded.feed("\r\n") }
    check(bounded.selection_text().as_str() == "old", "selection survives history at its limit")
    bounded.feed("\r\n")
    check(!bounded.has_selection(), "evicting selected history clears selection")
    bounded.feed("new")
    select(&bounded, 0, 0, 3, 0)
    bounded.feed("\r\n")
    check(bounded.selection_text().as_str() == "new", "selection tracks rows after history eviction")

    check(input.mouse_coordinate(42.0, 500, 1000, 24, 20, 40, true) == 3, "HiDPI cursor coordinates")
    check(input.mouse_coordinate(26.0, 500, 1000, 24, 20, 40, true) == 1, "left half of a cell")
    check(input.mouse_coordinate(28.0, 500, 1000, 24, 20, 40, true) == 2, "right half of a cell")
    check(input.mouse_coordinate(30.0, 500, 1000, 24, 24, 20, false) == 1, "row uses floor rather than nearest boundary")
    check(input.mouse_coordinate(-100.0, 500, 1000, 24, 20, 40, true) == 0, "left padding clamps")
    check(input.mouse_coordinate(10000.0, 500, 1000, 24, 20, 40, true) == 40, "right edge clamps")
    check(input.mouse_coordinate(42.0, 0, 0, 24, 20, 40, true) == 0, "zero-size window")
    check(input.key_sequence(67, 2, false).as_str() == "\x03", "Ctrl+C remains a child interrupt")
    println("selection: all checks passed")
}
