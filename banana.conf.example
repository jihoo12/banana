# Banana configuration: copy to ~/.config/banana/banana.conf.
# Every line is `key = value`; `#` starts a comment. The command line can
# override any setting with `--set key=value`.

font = JetBrains Mono
font-size = 16
line-height = 1.3
padding = 14

# banana, midnight, matcha, ember, glacier or banana-light (`banana --list-themes`).
# Ctrl+Shift+T cycles through them while Banana runs.
theme = banana

# Any theme color can be replaced:
#   foreground, background, background-end, cursor, cursor-text, selection,
#   selection-text, accent, bar, bar-text, color0 … color15
# background = #101318
# color1 = #ff6b81

# Window background: a vertical gradient with a soft vignette.
gradient = true
vignette = 0.35
# Below 1, the compositor shows what is behind the window.
opacity = 1.0

# block, underline or bar. Applications may change it (DECSCUSR).
cursor-style = block
cursor-blink = true
cursor-glow = true
# The cursor glides to its new position instead of jumping.
cursor-trail = true
visual-bell = true

# Fast mode: no shaders, gradient, vignette, cursor glow, trail or blinking,
# and no vsync, for the lowest latency. Ctrl+Shift+F toggles it while Banana
# runs; `banana --fast` starts in it.
fast = false

# true, false, or auto: shown when a plugin has something to display.
status-bar = auto

# Post-processing shaders, applied in order (`banana --list-shaders`).
# NAME is looked up in ~/.config/banana/shaders, then the bundled ones;
# a path works too. Ctrl+Shift+S cycles through the bundled shaders.
# shader = bloom
# shader = crt

# Plugins: a name in ~/.config/banana/plugins or the bundled ones, or a path
# to a shared library. Text after the name is passed to the plugin.
plugin = clock %H:%M
plugin = activity
